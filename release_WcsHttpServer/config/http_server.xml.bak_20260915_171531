<?xml version="1.0" encoding="UTF-8"?>
<config>
    <!-- 配置文件版本号，与软件版本匹配检查 -->
    <configVersion>1</configVersion>
    <!-- WMS 推送监听端口（WMS → WCS，修改后需重启服务） -->
    <wmsListenPort>8191</wmsListenPort>
    <!-- 正式环境满箱回传 URL（H7 满箱同步到WMS） -->
    <feedbackUrl>https://wms.pelliot.com.cn/gids5/service/thirdPartyData/dz_bxh_dmwcs_wms</feedbackUrl>
    <!-- 测试环境满箱回传 URL（H7） -->
    <feedbackTestUrl>http://127.0.0.1:8099/gwms5/service/openapi/product/skuClassificationTask/gwisSubProductClassifyOrder</feedbackTestUrl>
    <!-- 正式环境完结回传 URL（H8 波次完结通知WMS） -->
    <feedbackEndUrl>https://wms.pelliot.com.cn/gids5/service/thirdPartyData/dz_bxh_dmwcs_wms</feedbackEndUrl>
    <!-- 测试环境完结回传 URL（H8） -->
    <feedbackEndTestUrl>http://127.0.0.1:8099/gwms5/service/openapi/productClasTask/gwisSubProductClassifyEndOrder</feedbackEndTestUrl>
    <!-- ★ 满箱/锁格/波次完成回传 method（URL 参数 method，WMS 网关接口标识） -->
    <feedbackMethod>gwisSubProductClassifyOrder</feedbackMethod>
    <!-- ★ 完结回传(H8) method（URL 参数 method，WMS 网关接口标识） -->
    <feedbackEndMethod>gwisSubProductClassifyEndOrder</feedbackEndMethod>
    <!-- 正式环境 AppKey（HTTP Header + URL 参数 appkey） -->
    <appkey>dz_bxh_dmwcs_zs</appkey>
    <!-- 测试环境 AppKey -->
    <appkeyTest>dz_bxh_dmwcs_cs</appkeyTest>
    <!-- 是否使用测试环境（1=测试, 0=正式） -->
    <useTestEnv>1</useTestEnv>
    <!-- RFID SKU-EPC 绑定查询 URL（WCS 查询 RFID 获取 EPC→barcode 映射） -->
    <rfidQueryUrl>http://127.0.0.1:9100/open-api/rfid/query</rfidQueryUrl>
    <!-- RFID 查询 Authorization 头完整值（形如 APP_KEYS <key>，整串使用；空=不发送） -->
    <rfidAppkey>APP_KEYS e1235fda-029c-4270-913f-530342af2073</rfidAppkey>
    <!-- RFID 推送服务端地址（WCS 作为 TCP 客户端主动连接接收 EPC+carNum） -->
    <rfidPushServerIp>127.0.0.1</rfidPushServerIp>
    <rfidPushServerPort>2010</rfidPushServerPort>
    <!-- 是否向 RFID 服务端发送心跳包（1=发送 0=不发送，默认1） -->
    <rfidHeartbeatEnable>1</rfidHeartbeatEnable>
    <!-- 心跳发送间隔（毫秒，默认2000=2秒） -->
    <rfidHeartbeatIntervalMs>2000</rfidHeartbeatIntervalMs>
    <!-- ★ 2026-09-15 RFID 推送 EPC 码识别长度（字符数：只识别『A + (长度-1) 位数字』的 EPC，与开头是不是 A101 无关；默认24；小于2=不识别）—— 识别前 EPC 原文/整帧报文留痕于日志与数据库 rfid_raw 表 -->
    <rfidEpcTruncateLen>40</rfidEpcTruncateLen>
    <!-- 仓库编码 -->
    <warehouseCode>H</warehouseCode>
    <!-- 货主编码 -->
    <goodsOwner>BXH_CS</goodsOwner>
    <!-- 波次超时时间（分钟，0=不超时） -->
    <waveTimeoutMin>0</waveTimeoutMin>
    <!-- 异常 SKU 最大重试次数 -->
    <maxRetryCount>3</maxRetryCount>
    <!-- 期望绑定数量（波次下发校验用，默认1） -->
    <expectedBindCount>1</expectedBindCount>
    <!-- HTTP 回传请求超时（毫秒） -->
    <httpTimeoutMs>3000</httpTimeoutMs>
    <!-- 波次完成回传超时（毫秒） -->
    <waveCompleteTimeoutMs>2000</waveCompleteTimeoutMs>
    <!-- PLC TCP 监听端口（PLC 主动连接此端口，修改后需重启服务） -->
    <plcListenPort>2000</plcListenPort>
    <!-- S7 PLC IP 地址 -->
    <plcS7Ip>127.0.0.1</plcS7Ip>
    <!-- S7 机架号 -->
    <plcS7Rack>0</plcS7Rack>
    <!-- S7 槽位号 -->
    <plcS7Slot>1</plcS7Slot>
    <!-- 业务线程池大小 -->
    <businessPoolSize>90</businessPoolSize>
    <!-- PLC 发送线程池大小 -->
    <plcSendPoolSize>8</plcSendPoolSize>
    <!-- PLC 反馈接收线程池大小 -->
    <plcRecvPoolSize>4</plcRecvPoolSize>
    <!-- 日志保留天数 -->
    <logRetainDays>30</logRetainDays>
    <!-- fromLocation 取值来源（config=使用固定值, sobi=使用波次明细 sobi 来源库位） -->
    <h7FromLocationSource>sobi</h7FromLocationSource>
    <!-- 来源库位默认值（config 模式时使用） -->
    <h7DefaultFromLocation>A-01-03</h7DefaultFromLocation>
    <!-- 目标库位默认值（无容器号时兜底） -->
    <h7DefaultTargetLocation>66</h7DefaultTargetLocation>
    <!-- WMS 格口编码：对外格口号 = 前缀 + 格口号补零（默认 22+3位：格口号5 → 22005）；前缀留空=关闭转换 -->
    <gridCodePrefix>22</gridCodePrefix>
    <!-- 格口号补零宽度（默认 3，与内部/PLC 3位一致） -->
    <gridCodeWidth>3</gridCodeWidth>
    <!-- ★ 计划分配表总开关（true=按各格口计划数量分配；false=回退改造前'恒取首个格口'行为） -->
    <allocEnabled>true</allocEnabled>
    <!-- true=开工预检发现『Σ每格口计划 ≠ H4 orderQty』即拒绝开工（默认 false 仅告警） -->
    <allocRequirePlanValid>false</allocRequirePlanValid>
    <!-- 计划格口满箱未重绑(禁用)时，把未完成计划件转给同 SKU 其它可用计划格口（true/false） -->
    <allocGapMoveOnDisabled>true</allocGapMoveOnDisabled>
    <!-- 计划格口物理锁格时同样转移（true/false；false 时锁格格口不转移） -->
    <allocGapMoveOnLocked>true</allocGapMoveOnLocked>
    <!-- 在途认领上限（超出即强制清扫+异常留痕，防认领泄漏） -->
    <allocMaxInflight>2000</allocMaxInflight>
    <!-- 不变量巡检 + 认领超时清扫周期(ms) -->
    <allocAuditIntervalMs>30000</allocAuditIntervalMs>
    <!-- 认领超时(ms)：下发后迟迟无落格反馈则释放额度 -->
    <allocClaimTimeoutMs>30000</allocClaimTimeoutMs>
    <!-- 选格成功日志前 N 条逐条输出（0=全部逐条） -->
    <allocPlanLogTail>30</allocPlanLogTail>
    <!-- 之后每 N 条输出一条（异常/超计划/搬迁/兜底日志一律逐条保留） -->
    <allocPlanLogStep>500</allocPlanLogStep>
    <!-- EPC 任务内防重（true/false） -->
    <sortingEpcDedup>true</sortingEpcDedup>
    <!-- 【已废弃】格口上限策略（历史遗留，程序只读写不使用） -->
    <sortingGridCapPolicy>reject</sortingGridCapPolicy>
    <!-- ★ 超计划处置：exception=超计划件改投异常口 / block=超计划件不发指令并标注 / allow=仅标注 -->
    <sortingOverplanPolicy>exception</sortingOverplanPolicy>
    <!-- ★ 物理异常格口号（3位内部号如 066；留空或 0 = 未配置，则超计划件不发指令并告警） -->
    <exceptionGrid>66</exceptionGrid>
    <!-- orderQty 校验模式（strict=严格, loose=宽松） -->
    <sortingOrderQtyValidate>strict</sortingOrderQtyValidate>
    <!-- 冲突策略（STRICT_EXCEPTION=入异常口, LOOSE_FIRST=取首个匹配） -->
    <sortingConflictPolicy>STRICT_EXCEPTION</sortingConflictPolicy>
    <!-- 是否允许超收（true/false） -->
    <sortingAllowOverrecv>false</sortingAllowOverrecv>
    <!-- 重扫重投开关（true=已落格件重新上料仍按原格口下发；false=旧行为不再下发） -->
    <rescanResendEnabled>true</rescanResendEnabled>
    <!-- 同一 EPC 两次下发最小间隔(ms)，防 RFID 连读 -->
    <rescanResendCooldownMs>0</rescanResendCooldownMs>
    <!-- 同一 EPC 每波次最多重投次数（超限写异常表；首投不计入） -->
    <rescanResendMaxTimes>0</rescanResendMaxTimes>
    <!-- PLC 在途超时(ms)：未收到落格反馈超时后允许重投（防永久锁死） -->
    <plcInFlightTimeoutMs>30000</plcInFlightTimeoutMs>
    <!-- ① 波次下发（WMS → WCS，H4 推送波次数据） -->
    <apiInsertWaveInfo>/api/DispatchSortingCommand/InsertWaveInfo</apiInsertWaveInfo>
    <!-- ② 容器绑定（WMS → WCS，H6 格口容器绑定） -->
    <apiBindingLatticePort>/api/DispatchSortingCommand/BindingLatticePort</apiBindingLatticePort>
    <!-- ③ 波次取消（WMS → WCS，H5 退货任务取消） -->
    <apiInsertWaveIn>/api/DispatchSortingCommand/InsertWaveIn</apiInsertWaveIn>
