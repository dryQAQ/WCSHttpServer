/***************************************** 自定义控件   ***********************************/

/************* 左侧管理工具栏 ***************/
QWidget#mangeWidget, #listItemWidget, #MangeScrollAreaWidget {
    background-color: #f5f5f7;
}
QListWidget#MangeListWidget {
    border: none;
    outline: none;
    background-color: #f5f5f7;
}
QListWidget#MangeListWidget::item {
    background-color: #f5f5f7;
    border: solid
}
QListWidget#MangeListWidget::item:hover {
    background-color: #f5f5f7;
}
QListWidget#MangeListWidget::item:selected {
    background-color: #e6e7ea;
    border-left-width: 4px;
    border-left-color: #c62f2f;
}
QLabel#boxTitleLabel, #toolboxNameLabel {
    color: #696969;
    font-family: "Microsoft Yahei";
    font-size: 12pt;
    background-color: #f5f5f7;
}

QLabel#labConnectState {
    color: green;
    font-family: "Microsoft Yahei";
    font-size: 12pt;
}

QLabel#labConnectState::disabled {
    color: red;
}

QScrollArea#MangeScrollArea {
    border: 0px solid;
    border-right-width: 1px;
    border-right-color: #dcdbdc;
    background-color: #f5f5f7;
}

QPushButton#playListTitleButton, #openListButton,
        #createPLayListButton {
    border: none;
}
QPushButton#playListTitleButton {
    text-align : left;
    color: #696969;
    font-family: "Microsoft Yahei";
    font-size: 9pt;
    background-color: #f5f5f7;
}
/*QPushButton#openListButton {
    padding: 3px;
    image: url(:/images/rightArrow32_LightGray.png);
}*/
/*QPushButton#openListButton:hover {
    image: url(:/images/rightArrow32_Gray.png);
}*/
QPushButton#openListButton[mouseEnterPro=false]::!checked {
    padding: 2px;
    image: url(:/images/rightArrow32_LightGray.png);
}
QPushButton#openListButton[mouseEnterPro=false]::!checked:hover {
    padding: 2px;
    image: url(:/images/rightArrow32_Gray.png);
}
QPushButton#openListButton[mouseEnterPro=true]::!checked {
    padding: 2px;
    image: url(:/images/rightArrow32_Gray.png);
}
QPushButton#openListButton[mouseEnterPro=false]::checked {
    padding: 3px;
    image: url(:/images/downArrow32_LightGray.png);
}
QPushButton#openListButton[mouseEnterPro=false]::checked:hover {
    padding: 3px;
    image: url(:/images/downArrow32_Gray.png);
}
QPushButton#openListButton[mouseEnterPro=true]::checked {
    padding: 3px;
    image: url(:/images/downArrow32_Gray.png);
}
QPushButton#createPlayListButton {
    border: none;
    image: url(:/images/addPlaylist32_LightGray.png);
}
QPushButton#createPlayListButton:hover {
    image: url(:/images/addPlaylist32_Gray.png);
}
/*QPushButton#createPlayListButton {
    image: url(:/images/addPlaylist32_Gray.png);
}*/

QLabel#labErrorString{
    color: red;
}

QLabel#moduleTitle{
    color: black;
	font-size: 20px;
}

QLabel#calibTitle{
    color: black;
	font-size: 16px;
}

QLabel#calibSuccessTitle{
    color: #00ff7f;
	font-size: 16px;
}

QScrollArea{
    border: none;
}

QWidget#HLatestCard{
    background: white;
	border-radius: 10px;
	border-bottom: 1px solid qlineargradient(y0:0, y1:1,stop: 0 white, stop: 1  #ececef);
}

QWidget#HCard{
    background: white;
	border-radius: 5px;
	border: 1px solid #EBEBEB;
}
QWidget#HCard[mouseEnterPro=true]{
    background: #E8E8E8;
}
QWidget#HCard[mouseEnterPro=false]{
    background: white;
}

FrmStatistic#FrmStatistic{
	margin: 0px;
    border-right: 1px solid #e1e2e2;
	background-color: #f5f5f7;
}

QStatusBar#statusBar{
    margin: 0px;
    border-top: 1px solid #e1e2e2;
	background-color: #f6f6f8;
}

HProduceViewContainerItem{
    text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #4C4D4E;
	border-radius :3px;
	width: 80px;
	height: 30px;
}

HProduceView{
    text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #4C4D4E;
	border-radius :3px;
	width: 80px;
	height: 30px;
}

HProduceView[IsSelected=false]{
    border: 1px solid white;
}

HProduceView[IsSelected=true]{
    border: 1px solid #FF0000;
}

HLayoutSelectWidget{
    text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #303030;
	border-radius :3px;
}

/* HIconButton */
HIconButton {
	text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #303030;
	border-radius :3px;
}
 
HIconButton:hover {
	background: #515151;
}
 
/* 鼠标按下时 */
HIconButton:pressed {
	background: #515151;
}

QWidget#m_pWgtLayoutContent{
    background: #F2F3F5;
	border: 1px solid #D3D3D3;
}

/* QListWidget */
QListWidget#m_plWgtLayouts{
    background-color: #E3E4E6;
	color: #666666;
	outline: none;
	border: 1px solid #D3D3D3;
}

QListWidget#m_plWgtLayouts::item:selected{
    background-color: #F2F3F5;
	border-bottom: 1px solid red;
	color: #666666;
}

QStatusBar::item{
    border: none;
}
 
 
QFrame#frameMessageBox
{
	background-color:#ffffff;
	border-top: 1px solid red;
	border-left: 1px solid black;
	border-right: 1px solid black;
	border-bottom: 1px solid black;
	border-radius:10px;
}

HMessageBox::QLabel{
    font-family: "Microsoft Yahei";
	font-size: 16px;
	color: #666666;
}

QWidget#wgtBtn{
    background: #E4E5E7;
	border: 1px solid #D3D3D3;
}

HDlgLayoutDesignerContainer{
    background-color: #353535;
	text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #303030;
	border-radius :3px;
}

HDlgLayoutDesignerContainerItem{
    background-color: #3E3F3F;
}

HDlgLayoutDesignerContainerItem[IsSelected=false]{
    border: 1px solid  #353535;;
}

HDlgLayoutDesignerContainerItem[IsSelected=true]{
    border: 1px solid red;
}

QWidget#HProduceViewEmpty{
    background: #3c3c3c;
	border: 1px solid #3e3e3f;
}

QWidget#m_pWgtHeader{
    background: #3c3c3c;
}

QWidget#m_pWgtContent{
    background: #f0f0f0;
}

HMetro{
    background: #f2f3f5;
	border: 1px solid #c3c3c3;
}

HMetroBase{
    background: #ffffff;
	border: 1px solid #e5e5e5;
	border-radius :3px;
}

QDateEdit{
    font-size: 16px;
	background-color: white;
	border-style: solid;
	border-width: 1px;
	border-color: rgb(100,100,100);
	spacing: 5pc;
}

QDateEdit::drop-down{
    width: 15px;
	border-left-width: 1px;
	border-left-style: solid;
	border-left-color: gray;
}

QLabel#horizonLine{
    max-height: 1px;
	background-color: #5e5e5e;
	margin-bottom: 15px;
	margin-top: 15px;
}

FrmMainContent{
    background-color: #fafafa;
}

FrmSubWindow{
    border: 1px solid #e1e2e2;
}

FrmSubWindow[IsSelected=false]{
    border: 1px solid #e1e2e2;
}

FrmSubWindow[IsSelected=true]{
    border: 1px solid #FF0000;
}

Frm3DViewer{
    border: 1px solid #e1e2e2;
}

Frm3DViewer[IsSelected=false]{
    border: 1px solid #e1e2e2;
}

Frm3DViewer[IsSelected=true]{
    border: 1px solid #FF0000;
}

FrmSubWindowHeader{
    background-color: #e8e8e9;
}

QSliderEx{
    background-color: #ffffff;
	border:1px solid #000000;
}

//首先是设置主体
QSlider{
    border-color: #bcbcbc;
}
QSlider::groove:horizontal {                                
    border: 1px solid #999999;                             
    height: 1px;                                           
    margin: 0px 0;                                         
    left: 5px; right: 5px; 
 }
 //设置中间的那个滑动的键 
QSlider::handle:horizontal {                               
     border: 0px ;                           
     border-image:  url(:/NiceTalk/Images/Setting/volume_nor.png);
     width: 15px;                                           
     margin: -7px -7px -7px -7px;                  
} 
//还没有滑上去的地方
QSlider::add-page:horizontal{
background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 #bcbcbc, stop:0.25 #bcbcbc, stop:0.5 #bcbcbc, stop:1 #bcbcbc); 

}
//已经划过的从地方
QSlider::sub-page:horizontal{                               
 background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 #439cf3, stop:0.25 #439cf3, stop:0.5 #439cf3, stop:1 #439cf3);                     
}

/* 轴承检测项目新增 */

