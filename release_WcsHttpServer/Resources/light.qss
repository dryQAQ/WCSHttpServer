/***************************************** Qt标准控件 ***********************************/

/* Shared */
QStackedWidget, QLabel, QPushButton, QRadioButton, QCheckBox,
QGroupBox, QStatusBar, QToolButton, QComboBox, QDialog{
    font-family: "Microsoft Yahei";
	color: #666666;
}

/* 背景色样式 */
QMainWindow, QDialog {        /* 主界面 */
    background-color: #F2F3F5;
}

QGroupBox
{
border:1px solid white;
font-weight: false; 
}

QGroupBox::title
{
font-size: 6px;
padding: 0px;
font-weight: bold;
color: red;
}


QStackedWidget{
    background-color: #292A2B；
}


/* QPushButton样式 */
QPushButton{        /* 按钮样式 */
    text-align:center ;
    color: #5e5e5e;
    border:none;
	background: #ffffff;
	margin: 3px;
	border-radius :3px;
	width: 80px;
	height: 30px;
	border:1px solid #dcdee2;
}

QPushButton:hover{ /* 鼠标在按钮上样式 */
    border-color: #57a3f3;
	color: #57a3f3;
}

QPushButton:pressed{ /* 按钮按下样式 */
    border-color: #2b85e4;
}

QPushButton::disabled{
    background-color: #f7f7f7;
	color: #d4ccce;
}

QPushButton#primary{        /* 按钮样式 */
    text-align:center ;
    color: #E2E2E2;
    border:none;
	background: #4C4D4E;
	margin: 3px;
	border-radius :3px;
	width: 80px;
	height: 30px;
	border:none;
}

QPushButton#primary:hover{ /* 鼠标在按钮上样式 */
    background: #545557;
}

QPushButton#primary:pressed{ /* 按钮按下样式 */
    background: #4C4D4E;
}

QPushButton#btnCancel{  /* 取消按钮样式 */
    border: 1px solid #555555;
	background: #292A2B;
	margin: 3px;
	border-radius :3px;
	min-width: 80px;
	min-height: 30px;
	border:none;
}

QPushButton#btnCancel:hover{ /* 鼠标在按钮上样式 */
    background: #545557;
}

QPushButton#btnCancel:pressed{ /* 按钮按下样式 */
    background: #4C4D4E;
}

QPushButton#btnMin{
    background-color: transparent;
	image: url(./Resources/Btn_Common_WinMinimize_Normal.png);
	border:none;
}

QPushButton#btnMin::hover{
    background: #545557;
	image: url(./Resources/Btn_Common_WinMinimize_Hover.png);
}

QPushButton#btnMin::pressed{
    background: #4C4D4E;
	image: url(./Resources/Btn_Common_WinMinimize_Pressed.png);
}

QPushButton#btnMax{
    background-color: transparent;
	image: url(./Resources/Btn_Common_WinMaximize_Normal.png);
	border:none;
}

QPushButton#btnMax::hover{
    background: #545557;
	image: url(./Resources/Btn_Common_WinMaximize_Hover.png);
}

QPushButton#btnMax::pressed{
    background: #4C4D4E;
	image: url(./Resources/Btn_Common_WinMaximize_Pressed.png);
}

QPushButton#btnClose{
    background-color: transparent;
	image: url(./Resources/Btn_Common_WinClose_Normal.png);
	border:none;
}

QPushButton#btnClose::hover{
    background: #545557;
	image: url(./Resources/Btn_Common_WinClose_Hover.png);
}

QPushButton#btnClose::pressed{
    background: #4C4D4E;
	image: url(./Resources/Btn_Common_WinClose_Pressed.png);
}


QPushButton#btnOK2{        /* 按钮样式 */
    text-align:center ;
    color: #b2b2b2;
    border: 1px solid #b2b2b2;
	background: #dddddc;
	margin: 3px;
	border-radius :3px;
	width: 40px;
	height: 20px;
}

QPushButton#btnOK2:hover{ /* 鼠标在按钮上样式 */
    background: #f38486;
	color: white;
}

QPushButton#btnOK2:pressed{ /* 按钮按下样式 */
    	color: #b2b2b2;
}

QPushButton#btnCancel2{  /* 取消按钮样式 */
    text-align:center ;
    color: #b2b2b2;
    border: 1px solid #b2b2b2;
	background: transparent;
	margin: 3px;
	border-radius :3px;
	width: 40px;
	height: 20px;
}

QPushButton#btnCancel2:hover{ /* 鼠标在按钮上样式 */
    background: #f38486;
	color: white;
}

QPushButton#btnCancel2:pressed{ /* 按钮按下样式 */
    	color: #b2b2b2;
}

QPushButton#btnClose2{
    background-color: transparent;
	border-radius: 10px;
	image: url(./Resources/Btn_Common_WinClose_Normal.png);
	border:none;
}

QPushButton#btnClose2::hover{
	image: url(./Resources/Btn_Common_WinClose_Hover.png);
}

QPushButton#btnClose2::pressed{
	image: url(./Resources/Btn_Common_WinClose_Pressed.png);
}




QPushButton#btnRestore{
    background-color: transparent;
	image: url(./Resources/Btn_Common_WinRestore_Normal.png);
	border:none;
}

QPushButton#btnRestore::hover{
    background: #545557;
	image: url(./Resources/Btn_Common_WinRestore_Hover.png);
}

QPushButton#btnRestore::pressed{
    background: #4C4D4E;
	image: url(./Resources/Btn_Common_WinRestore_Pressed.png);
}

QPushButton#btnLogin{        /* 按钮样式 */
    text-align:center ;
    color: #E2E2E2;
    border:none;
	background: transparent;
	margin: 3px;
	border-radius :3px;
	width: 80px;
	height: 30px;
}

QPushButton#btnLogin:hover{ /* 鼠标在按钮上样式 */
    background: #545557;
}

QPushButton#btnLogin:pressed{ /* 按钮按下样式 */
    background: #4C4D4E;
}


.QToolButton{
	font-family: "Microsoft YaHei";
	border-style:none;
	border:0px;
	color:#000000;
	padding:5px;
	min-height:15px;
	border-radius:5px;
}

.QToolButton:hover {
   background-color: khaki;
}

QToolButton#tbSubItem{
	font-family: "Microsoft YaHei";
	border: 1px solid #dcdcdc;
	background-color: #0081ff;
	color:#000000;
	padding:5px;
	min-height:15px;
	border-radius:5px;
}

QToolButton#tbSubItem:hover {
   background-color: khaki;
}

QToolButton#HToolButton {
	border:none;
	border-radius:5px;
	background-color:292A2B;
}
 
QToolButton#HToolButton:hover {
	background-color:#545557；
}
 
/* 鼠标按下时 */
QToolButton#HToolButton:pressed {
	background-color:#4C4D4E；
}
 
/* 按钮有菜单时 */
QToolButton::menu-button {
	border:2px solid red;
	border-top-right-radius:6px;
	border-bottom-right-radius:6px;
	width = 16px;
}


/* QTabBar样式 */
QTabBar::tab{
    text-align: center;
	height: 30px;
	min-width: 120px;
	color: white;
	background: transparent;
	font-size: 17px;
	font-family: "Microsoft Yahei";
	margin-left: 0px;
	margin-right: 0px;
	margin-bottom: 0px;
}

QTabBar::tab:selected{
    text-align: center;
    color: red;
	border-bottom:2px solid #FF0000;
	background: transparent;
}

/* QTabWidget样式 */
QTabWidget::tab-bar{
    left: 2px;
	color: black;
}


/* QRadioButton样式 */
QRadioButton{
    color: #666666;
}

QRadioButton:hover{
    color: #444444;
}

QRadioButton::disabled{
    color: #E2E2E2;
}


QRadioButton::indicator{
	background-color: transparent;
	image: url(./Resources/RadioBtn_Common_Unchecked_Normal.png);
}

QRadioButton::indicator::disabled{
	image: url(./Resources/RadioBtn_Common_Unchecked_Disable.png);
}

QRadioButton::indicator::hover{
	image: url(./Resources/RadioBtn_Common_Unchecked_Hover.png);
}

QRadioButton::indicator::pressed{
	image: url(./Resources/RadioBtn_Common_Unchecked_Pressed.png);
}

QRadioButton::indicator::checked{
	image: url(./Resources/RadioBtn_Common_Checked_Normal.png);
}

QRadioButton::indicator::checked::disabled{
	image: url(./Resources/RadioBtn_Common_Checked_Disable.png);
}

QRadioButton::indicator::checked::hover{
	image: url(./Resources/RadioBtn_Common_Checked_Hover.png);
}

QRadioButton::indicator::checked::hover{
	image: url(./Resources/RadioBtn_Common_Checked_Pressed.png);
}

QRadioButton#radStatus::disabled{
    color: #666666;
}

/* QCheckBox样式 */
QCheckBox{
    color: #5e5e5e;
}

QCheckBox:hover{
    color: #232426;
}

QCheckBox::indicator{
    background-color: transparent;
	image: url(./Resources/CheckBox_Common_Unchecked_Normal.png);
}

QCheckBox::indicator::hover{
    image: url(./Resources/CheckBox_Common_Unchecked_Hover.png);
}

QCheckBox::indicator::disabled{
    image: url(./Resources/CheckBox_Common_Unchecked_Disable.png);
}

QCheckBox::indicator::pressed{
    image: url(./Resources/CheckBox_Common_Unchecked_Pressed.png);
}

QCheckBox::indicator::checked{
    image: url(./Resources/CheckBox_Common_Checked_Normal.png);
}

QCheckBox::indicator::checked::hover{
    image: url(./Resources/CheckBox_Common_Checked_Hover.png);
}

QCheckBox::indicator::checked::disabled{
    image: url(./Resources/CheckBox_Common_Checked_Disable.png);
}

QCheckBox::indicator::checked::pressed{
    image: url(./Resources/CheckBox_Common_Checked_Pressed.png);
}

/* QLabel样式 */
QLabel{
    color: #666666;
}

/* QLineEdit样式 */
QLineEdit{
    color: #5e5e5e;
	padding-left: 5px;
	padding-top: 2px;
	padding-right: 5px;
	padding-bottom: 2px;
	background-color: #ffffff;
	border: 1px solid #dcdee2;
}

QLineEdit:focus{
    border: 1px solid #FF0000;
}

/* QTextEdit样式 */
QTextEdit{
    color: #5e5e5e;
	padding-left: 5px;
	padding-top: 2px;
	padding-right: 5px;
	padding-bottom: 2px;
	background-color: #ffffff;
	border: 1px solid #dcdee2;
}

QTextEdit:focus{
    border: 1px solid #FF0000;
}

/* QComboBox样式 */
QComboBox{
    color: #5e5e5e;
	padding-left: 5px;
	padding-top: 2px;
	padding-right: 5px;
	padding-bottom: 2px;
	background-color: #fcfcfc;
	border: 1px solid #dcdee2;
	min-height: 30px;
	font-size: 17px;
}

QComboBox::drop-down{
    border: none;
}

QComboBox::down-arrow{
    image: url(./Resources/Icon_ComboBox_ArrowDown_Normal.png);
}

QComboBox::down-arrow::disabled{
    image: url(./Resources/Icon_ComboBox_ArrowDown_Disable.png);
}

QComboBox::down-arrow::hover{
    image: url(./Resources/Icon_ComboBox_ArrowDown_Hover.png);
}

QComboBox::down-arrow::pressed{
    image: url(./Resources/Icon_ComboBox_ArrowDown_Pressed.png);
}

QComboBox:focus{
    border: 1px solid #FF0000;
}

QComboBox:on {
    padding-top: 3px;
    padding-left: 4px;
}



QComboBox QAbstractItemView {
    color: #5e5e5e;
    height: 35px;
	border:0px solid white;
	background-color: #fcfcfc;
	selection-color: #ff0000;
	selection-background-color: #d9d7d7;
	font-size: 16px;
}

QComboBox QAbstractItemView::item {
    height: 30px;
}

QComboBox QAbstractItemView::item::selected {
    background-color: #d9d7d7;
	border-bottom: 1px solid red;
}


/* QSpinBox样式 */
QSpinBox{
    color: #5e5e5e;
	padding-left: 5px;
	padding-top: 2px;
	padding-right: 5px;
	padding-bottom: 2px;
	background-color: #ffffff;
	border: 1px solid #dcdee2;
}

QSpinBox::up-button{
    border-image:url(./Resources/up_arrow.png);
	width: 15px;
}

QSpinBox::down-button{
    border-image:url(./Resources/down_arrow.png);
	width: 15px;
}

QSpinBox:focus{
    border: 1px solid #FF0000;
}

/* QDoubleSpinBox样式 */
QDoubleSpinBox{
    color: #5e5e5e;
	padding-left: 5px;
	padding-top: 2px;
	padding-right: 5px;
	padding-bottom: 2px;
	background-color: #ffffff;
	border: 1px solid #dcdee2;
}

QDoubleSpinBox::up-button{
    border-image:url(./Resources/up_arrow.png);
	width: 15px;
}

QDoubleSpinBox::down-button{
    border-image:url(./Resources/down_arrow.png);
	width: 15px;
}

QDoubleSpinBox::up-button:pressed {
    margin-top:3px;
}

QDoubleSpinBox::down-button:pressed {
    margin-bottom:3px;
}

QDoubleSpinBox:focus{
    border: 1px solid #FF0000;
}



/* QTableWidget样式 */
QHeaderView{
    background: #f8f8f9;
}

QHeaderView::section{
    font-family: "Microsoft Yahei";
	font-weight: bold;
	background: #f8f8f9;
	font-size: 16px;
	border: none;
	text-algin: center;
	color: #5e5e5e;
	min-height: 30px;
}

QTableWidget::item{
    outline: none;
}

QTableWidget::item::selected{
	background: #e6e7ea;
	color: #5e5e5e;
	border-bottom: 1px solid red;
}

QTableWidget::item::focus{
    outline: none;
}

QTableWidget{
    background-color: #f5f5f7;
    alternate-background-color: #ffffff;
	outline: none;
	color: #5e5e5e;
	border: none;
}

/* QScrollBar样式 */
QScrollBar{
    background-color: #e6e7ea;
}

QScrollArea {
    background-color: #e6e7ea;
}

QScrollBar::handle:vertical{
    background: rgba(255,0,0,20%);
	border: 0px solid grey;
	border-radius: 3px;
	width: 8px;
}

QScrollBar::handle:vertical::hover{
    background: rgba(255,0,0,40%);
}

QScrollBar::handle:vertical::pressed{
    background: rgba(255,0,0,80%);
}

QScrollBar::vertical{
    border-width: 1px;
	border-style: solid;
	border-color: transparent;
	width: 12px;
	margin: 0px;
	border-radius: 3px;
	background-color: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;  
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical{
    background: transparent; 
}


QScrollBar::handle:horizontal{
    background: rgba(255,0,0,20%);
	border: 0px solid grey;
	border-radius: 3px;
	height: 15px;
}

QScrollBar::handle:horizontal::hover{
    background: rgba(255,0,0,40%);
}

QScrollBar::handle:horizontal::pressed{
    background: rgba(255,0,0,80%);
}


QScrollBar::horizontal{
    border-width: 1px;
	border-style: solid;
	border-color: transparent;
	height: 12px;
	margin: 0px;
	border-radius: 3px;
	background-color: transparent;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;  
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal{
    background: transparent;   
}


/* QMenu样式 */
QMenu{
    background-color: #373839;
	color: #B1C3D3;
	border: none;
}

QMenu::item{
    background-color: transparent;
    margin: 0px;
	padding: 8px 25px 8px 20px;
	min-width: 100px;
}

QMenu::item:selected{
    background-color: #414244;
	border-bottom: 1px solid red;
}

QMenu::item:disabled{
    color:#666666;
}

QMenu::separator {
    height: 1px;
    background: #222222;
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 1px;
    margin-bottom: 1px;
}

/* QMenuBar样式 */
QMenuBar{
    background-color: #1F2021;
	color: #B1C3D3;
	font-family: "Microsoft Yahei";
	font-size: 14px;
}

QMenuBar::item{
    margin:2px 20px 2px 0px;
	padding:5px 10px 5px 10px;
}


QMenuBar::item:hover{
    color: #FFFFFF;
	background-color: #373839;
	
}

QMenuBar::item:selected{
    color: #FFFFFF;
	background-color: #373839;
}

/* QTreeWidget */
QTreeWidget{
    background-color: #ffffff;
	color: #5e5e5e;
	outline: none;
}

QTreeWidget::item:selected{
    background-color: #ebf7ff;
	border-bottom: 1px solid red;
}

/* QListWidget 	outline: none;*/
QListWidget{
	background-color: #132030;
	color: #caddf0;
	border:none;
	height: 80px;
	font-size:30px;
}

QListWidget::item{
    height: 60px;
	background-color: #132030;
	color: #caddf1;
}

QListWidget::item:selected{
    background-color: #133251;
	color: #caddf8;
	border-bottom: 2px solid red;
	font-size:20px
}

QListWidget#lwgtSettings{
    background-color: #e2e3e6;
	color: #B1C3D3;
	outline: none;
	border: none;
}

QListWidget#lwgtSettings::item{
    background-color: transparent;
	height: 70px;
	border: none;
	color: #4c4c4c;
	padding-left: 15px;
}

QListWidget#lwgtSettings::item:selected{
    background-color: #f2f3f6;
	color: #4c4c4c;
	border-bottom: 1px solid red;
}

