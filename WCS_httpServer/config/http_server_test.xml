<?xml version="1.0" encoding="UTF-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- http_server_test.xml — 测试环境专用配置                                -->
<!--                                                                         -->
<!-- 与生产配置的区别:                                                        -->
<!--   - WMS 回传 URL: 指向本地 mock_wms_receiver.py (端口 9002)             -->
<!--   - RFID 查询 URL: 指向本地 mock_rfid_server.py  (端口 9003)            -->
<!--   - 格口显示名:   简化格式 #01~#66                                       -->
<!--                                                                         -->
<!-- 使用方法:                                                               -->
<!--   1. 复制此文件覆盖 http_server.xml，放在 {exe}/config/ 目录下          -->
<!--   2. 启动 3 个终端:                                                      -->
<!--      终端1: python mock_wms_receiver.py   (监听 0.0.0.0:9002)           -->
<!--      终端2: python mock_rfid_server.py    (监听 0.0.0.0:9003)           -->
<!--      终端3: 双击 WCS_httpServer.exe → 点击"启动服务"                    -->
<!--   3. 运行: cd D:\test && python test_full_flow.py                       -->
<!--                                                                         -->
<!-- ★ 双机测试时，将 127.0.0.1 替换为对方电脑的内网 IP                       -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->

<config>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 一、WMS 监听端口 — 与生产环境一致                                   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <wmsListenPort>8191</wmsListenPort>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 二、WMS 回传接口                                                 -->
    <!--    ★ 测试环境指向本地 mock 服务                                   -->
    <!--    feedbackTestUrl: mock_wms_receiver.py 监听地址                 -->
    <!--    useTestEnv=1 使用测试环境 URL 和 AppKey                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <feedbackUrl>http://47.93.21.77:9090/gids5/service/thirdPartyData/dz_bxh_wcs_zs</feedbackUrl>
    <feedbackTestUrl>http://127.0.0.1:9002/callback</feedbackTestUrl>
    <appkey>dz_bxh_wcs_zs</appkey>
    <appkeyTest>dz_bxh_wcs_cs</appkeyTest>
    <useTestEnv>1</useTestEnv>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 三、WMS 业务参数                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <warehouseCode>A</warehouseCode>
    <goodsOwner>BXH_ZS</goodsOwner>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 四、波次管理 — 测试环境不设超时(0)，便于调试                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <waveTimeoutMin>0</waveTimeoutMin>
    <maxRetryCount>3</maxRetryCount>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 五、网络超时 — 与生产环境一致，保证回传及时                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <httpTimeoutMs>3000</httpTimeoutMs>
    <waveCompleteTimeoutMs>2000</waveCompleteTimeoutMs>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 六、PLC 通信                                                     -->
    <!--    plcListenPort: 用于 ncat/Python 模拟 PLC 连接                  -->
    <!--    plcS7Ip:        S7 PLC IP，测试环境无实物 → 连不上是正常的        -->
    <!--    S7 未连接不影响 TCP 文本协议测试，仅影响锁格回传                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <plcListenPort>8192</plcListenPort>
    <plcS7Ip>192.168.0.1</plcS7Ip>
    <plcS7Rack>0</plcS7Rack>
    <plcS7Slot>1</plcS7Slot>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 七、线程池 — 与生产环境一致                                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <businessPoolSize>90</businessPoolSize>
    <plcSendPoolSize>8</plcSendPoolSize>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 八、日志 — 30天保留                                              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <logRetainDays>30</logRetainDays>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 九、RFID 查询                                                    -->
    <!--    ★ 测试环境指向本地 mock_rfid_server.py                         -->
    <!--    返回伪造的 EPC→SKU 映射用于验证查询链路                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <rfidUrl>http://127.0.0.1:9003/query</rfidUrl>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 十、API 路由路径（WMS 调用 WCS 的接口 URL）                       -->
    <!--    默认值与 define.h 宏一致，可按需修改                             -->
    <!--    修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <apiInsertWaveInfo>/api/DispatchSortingCommand/InsertWaveInfo</apiInsertWaveInfo>
    <apiBindingLatticePort>/api/DispatchSortingCommand/BindingLatticePort</apiBindingLatticePort>
    <apiInsertWaveIn>/api/DispatchSortingCommand/InsertWaveIn</apiInsertWaveIn>

    <!-- ═══════════════════════════════════════════════════════════════ -->
