<?xml version="1.0" encoding="UTF-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- http_server.xml — WCS_httpServer 生产环境配置                          -->
<!--                                                                         -->
<!-- 配置文件位置: {exe目录}/config/http_server.xml                          -->
<!-- 首次运行自动生成，修改后重启服务生效                                     -->
<!--                                                                         -->
<!-- ★ 注意:                                                                 -->
<!--   - 回传URL/AppKey 和 波次超时 修改后立即生效                            -->
<!--   - wmsListenPort/plcListenPort 修改后需重启服务（UI显示"(需重启)"）     -->
<!--   - 容器绑定由 WMS 运行时下发，服务停止时自动清空                         -->
<!--   - RFID URL 中的 {BaseURL} 需替换为实际地址                              -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->

<config>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 一、WMS 监听端口                                                 -->
    <!--    WCS_httpServer 对外提供的 HTTP 服务端口                        -->
    <!--    WMS 通过此端口推送波次数据、容器绑定、退货取消指令               -->
    <!--    修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <wmsListenPort>8191</wmsListenPort>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 二、WMS 回传接口                                                 -->
    <!--    波次完成/锁格时，WCS 主动向 WMS 发送回传报文                    -->
    <!--    useTestEnv 控制使用正式环境还是测试环境                         -->
    <!--    AppKey 放在 HTTP Header: AppKey=xxx                          -->
    <!--    修改后立即生效                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 正式环境 -->
    <feedbackUrl>http://47.93.21.77:9090/gids5/service/thirdPartyData/dz_bxh_wcs_zs</feedbackUrl>
    <appkey>dz_bxh_wcs_zs</appkey>

    <!-- 测试环境 -->
    <feedbackTestUrl>http://182.92.166.232/gids5/service/thirdPartyData/dz_bxh_wcs_cs</feedbackTestUrl>
    <appkeyTest>dz_bxh_wcs_cs</appkeyTest>

    <!-- 环境切换: 1=测试环境, 0=正式环境 -->
    <useTestEnv>1</useTestEnv>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 三、WMS 业务参数（回传报文中使用）                                 -->
    <!--    warehouseCode: 仓库编码                                        -->
    <!--    goodsOwner:     货主编码                                       -->
    <!--    修改后立即生效                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <warehouseCode>A</warehouseCode>
    <goodsOwner>BXH_ZS</goodsOwner>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 四、波次管理                                                     -->
    <!--    waveTimeoutMin: 波次超时(分钟)                                 -->
    <!--      0 = 不超时，波次必须全部条码分拣完成才回传                    -->
    <!--      设为正数时，超时后强制回传（即使有未分拣条码）                 -->
    <!--    maxRetryCount:  异常 SKU 最大重试次数                          -->
    <!--      超出后标记为永久异常                                         -->
    <!--    修改后立即生效                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <waveTimeoutMin>0</waveTimeoutMin>
    <maxRetryCount>3</maxRetryCount>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 五、网络超时(ms)                                                 -->
    <!--    httpTimeoutMs:         WMS 回传 HTTP 请求超时                   -->
    <!--    waveCompleteTimeoutMs: 波次完成回传超时（≤2秒, WMS 要求）       -->
    <!--    修改后立即生效                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <httpTimeoutMs>3000</httpTimeoutMs>
    <waveCompleteTimeoutMs>2000</waveCompleteTimeoutMs>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 六、PLC 通信                                                     -->
    <!--    plcListenPort: TCP 文本协议监听端口                            -->
    <!--      PLC 主动连接此端口进行 {识别码|格口|小车号} 格式的通信          -->
    <!--      TODO: 识别码可能为条码或EPC，客户尚未确定（2026-08-04）        -->
    <!--      TODO: 小车号应由RFID提供，客户尚未提供（2026-08-04）           -->
    <!--      修改后需重启服务                                               -->
    <!--    plcS7Ip:  S7 协议 PLC IP 地址                                  -->
    <!--      用于 DB1 写入分拣指令 + DB77 读取锁格状态                       -->
    <!--      S7 未连接不影响 TCP 文本通信，仅影响锁格回传                    -->
    <!--      修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <plcListenPort>8192</plcListenPort>
    <plcS7Ip>192.168.0.1</plcS7Ip>
    <plcS7Rack>0</plcS7Rack>
    <plcS7Slot>1</plcS7Slot>

    

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 七、线程池                                                       -->
    <!--    businessPoolSize: 业务线程池大小（处理 HTTP 请求 + 回传构建）   -->
    <!--      线程数 = 90，适合 16 核机器 + 高并发场景                       -->
    <!--      修改后需重启服务                                               -->
    <!--    plcSendPoolSize:  PLC 发送专用线程池                            -->
    <!--      S7 DBWrite 同步阻塞 10~100ms，异步入池防止 I/O 线程阻塞        -->
    <!--      修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <businessPoolSize>90</businessPoolSize>
    <plcSendPoolSize>8</plcSendPoolSize>
    <plcRecvPoolSize>4</plcRecvPoolSize>
    

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 八、日志                                                         -->
    <!--    logRetainDays: 日志文件保留天数                                -->
    <!--      超过天数的日志自动清理                                         -->
    <!--      日志路径: {exe}/log/{模块名}/{模块名}.log                      -->
    <!--      四个模块: WCS, PLC, HTTP, LIFECYCLE                           -->
    <!--      修改后立即生效                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <logRetainDays>30</logRetainDays>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 九、RFID 查询                                                    -->
    <!--    波次推送后 WCS 向 RFID 服务查询 EPC→SKU 绑定关系               -->
    <!--    {BaseURL} 需替换为实际 RFID 服务地址                             -->
    <!--    如: http://192.168.1.200:8080/open-api/rfid/query               -->
    <!--    修改后需重启服务                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
<rfidUrl>http://192.168.3.53:9100/open-api/rfid/query</rfidUrl>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 十、API 路由路径（WMS 调用 WCS 的接口 URL）                       -->
    <!--    与 define.h 中的宏保持同名，XML 可覆盖宏默认值                  -->
    <!--    修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <apiInsertWaveInfo>/api/DispatchSortingCommand/InsertWaveInfo</apiInsertWaveInfo>
    <apiBindingLatticePort>/api/DispatchSortingCommand/BindingLatticePort</apiBindingLatticePort>
    <apiInsertWaveIn>/api/DispatchSortingCommand/InsertWaveIn</apiInsertWaveIn>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 十一、H7 满箱同步配置（WCS→WMS，需求 §10）                        -->
    <!--    h7FromLocationSource: fromLocation 取值来源                     -->
    <!--      config = 使用 h7DefaultFromLocation 固定值                    -->
    <!--      volu   = 使用波次明细中的 volu 字段（默认）                   -->
    <!--      TODO: RQ-04 待确认 volu 与 fromLocation 的映射关系（2026-08-04）-->
    <!--    h7DefaultFromLocation: config 模式下的来源库位默认值            -->
    <!--    修改后需重启服务                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h7FromLocationSource>volu</h7FromLocationSource>
    <h7DefaultFromLocation>A-01</h7DefaultFromLocation>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 十二、S7 分拣增强配置（T-S7-02/04/06/07）                       -->
    <!--    sortingEpcDedup: EPC 任务内防重（true/false）                 -->
    <!--      true=按orderCode+epc去重，false=关闭                       -->
    <!--    sortingGridCapPolicy: 格口达计划上限策略                      -->
    <!--      reject=拒收 / exception=入异常口 / allow=允许超收          -->
    <!--    sortingOrderQtyValidate: orderQty与明细合计校验模式           -->
    <!--      strict=严格(不一致则拒绝) / loose=宽松(仅告警)              -->
    <!--    sortingConflictPolicy: 分类vs发货冲突策略                    -->
    <!--      STRICT_EXCEPTION=入异常口 / LOOSE_FIRST=取首个匹配         -->
    <!--    sortingAllowOverrecv: 是否允许超收（快捷开关，true覆盖上限策略） -->
    <!--    修改后需重启服务                                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <sortingEpcDedup>true</sortingEpcDedup>
    <sortingGridCapPolicy>reject</sortingGridCapPolicy>
    <sortingOrderQtyValidate>strict</sortingOrderQtyValidate>
    <sortingConflictPolicy>STRICT_EXCEPTION</sortingConflictPolicy>
    <sortingAllowOverrecv>false</sortingAllowOverrecv>

