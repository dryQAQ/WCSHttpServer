<?xml version="1.0" encoding="UTF-8"?>
<config>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 服务配置                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <wmsListenPort>8190</wmsListenPort>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- WMS 回传接口（WCS → WMS）                                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <feedbackUrl>http://47.93.21.77:9090/gids5/service/thirdPartyData/dz_bxh_wcs_zs</feedbackUrl>
    <feedbackTestUrl>http://182.92.166.232/gids5/service/thirdPartyData/dz_bxh_wcs_cs</feedbackTestUrl>
    <appkey>dz_bxh_wcs_zs</appkey>
    <appkeyTest>dz_bxh_wcs_cs</appkeyTest>
    <useTestEnv>1</useTestEnv>

    <!-- WMS 业务参数（回传用） -->
    <warehouseCode>A</warehouseCode>
    <goodsOwner>BXH_ZS</goodsOwner>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 波次管理                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <waveTimeoutMin>0</waveTimeoutMin>
    <maxRetryCount>3</maxRetryCount>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 网络超时(ms)                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <httpTimeoutMs>3000</httpTimeoutMs>
    <waveCompleteTimeoutMs>2000</waveCompleteTimeoutMs>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- PLC 通信                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <plcListenPort>8199</plcListenPort>
    <plcS7Ip>192.168.0.1</plcS7Ip>
    <plcS7Rack>0</plcS7Rack>
    <plcS7Slot>1</plcS7Slot>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 线程池                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <businessPoolSize>90</businessPoolSize>
    <plcSendPoolSize>8</plcSendPoolSize>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 日志                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <logRetainDays>30</logRetainDays>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- RFID 查询（EPC→SKU绑定关系）                                     -->
    <!-- BaseURL 需替换为实际RFID服务地址                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <rfidUrl>http://{BaseURL}/open-api/rfid/query</rfidUrl>

    <!-- ═══════════════════════════════════════════════════════════════ -->
